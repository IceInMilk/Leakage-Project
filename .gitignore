```gitignore
# Python
__pycache__/
*.pyc
*.egg-info/
*.orig
*py.bak

# Editors and IDEs
*.swp
*.epf
.vscode/
**/.vscode/*
.venv/
**/ipynb_checkpoints/

# Build output
/build/
/dist/
**/_build/
*.o
*.d
*.lst
*.o.s
*.elf
*.eep
*.hex
*.lss
*.map
*.sym
*.vcd
*.fst
*.cwp
*_data
default-data-dir/

# ChipWhisperer build artifacts
firmware/**/*.bin
firmware/mcu/simpleserial-base-lab*
hardware/victims/firmware/simpleserial-*/simpleserial-*-CW*
hardware/victims/firmware/basic-passwdcheck/basic-passwdcheck-CW*

# Existing upstream-specific exclusions
*.autopilot/*
*.autopilot*
*.s#*
*.b#?
software/capture/capture-*
software/capture/default-data-dir*
software/capture/scopes/cw-partial-files/ztex_rev2_1.11c_ise*
software/chipwhisperer/logs/*
software/chipwhisperer/capture/default-data-dir/*
software/chipwhisperer/capture/capture-2013.*
software/chipwhisperer/capture/scopes/cw-partial-files/ztex_rev2_1.11c_ise/*
hardware/capture/chipwhisperer-rev2/ezusb-firmware/ztex-sdk/bmp/tests*
hardware/victims/firmware/hal/rx65n/include/r_tsip_rx_if.h
hardware/victims/firmware/hal/rx65n/*.lib
docs/*.msi
docs/_build/
docs/make.bat
docs/contributing.rst
docs/tutorials/*.rst
docs/tutorials/img/*

# Local machine files
*Zone.Identifier
50-newae.rules

# Local ChipWhisperer minimal-package generator
gen_minimal.sh

# Exclude unrelated upstream components
/docs/
/tests/
/software/
/openocd/
/openadc/
.readthedocs.yaml
contributing.md
CHANGES.txt
FW_CHANGES.txt

# Jupyter: ignore everything except personal work
/jupyter/*
!/jupyter/user/
/jupyter/user/*
!/jupyter/user/**

# Preserve selected prebuilt device binaries if needed
!**/ChipWhisperer-Nano.bin
!**/ChipWhisperer-Lite.bin
!**/ChipWhisperer-CW305.bin
!**/ChipWhisperer-Husky.bin
